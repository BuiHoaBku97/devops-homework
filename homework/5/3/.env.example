USER_DB_USERNAME=postgres
USER_DB_PW=postgres
USER_DB_URL=jdbc:postgresql://user-db-service:5432/user_db

# Restaurant database
RESTAURANT_DB_PORT=5434
RESTAURANT_DB_USERNAME=postgres
RESTAURANT_DB_PW=postgres
RESTAURANT_DB_URL=jdbc:postgresql://restaurant-db-service:5432/restaurant_db

# Order database
ORDER_DB_PORT=5435
ORDER_DB_USERNAME=postgres
ORDER_DB_PW=postgres
ORDER_DB_URL=jdbc:postgresql://order-db-service:5432/order_db

# Notification database
NOTIFICATION_DB_PORT=5436
